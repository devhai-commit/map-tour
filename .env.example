# Copy thành .env cùng thư mục này trước khi chạy docker compose,
# và KHÔNG commit file .env thật lên git.
POSTGRES_DB=map-tour
POSTGRES_USER=admin
POSTGRES_PASSWORD=map-tour
POSTGRES_PORT=5436

# Cổng cho Adminer (chỉ dùng khi bật profile "tools")
ADMINER_PORT=8090

# Cổng cho API map-tour (map-tour/server) khi chạy qua docker compose
API_PORT=8787
# Origin của frontend map-tour được phép gọi API (CORS), đổi khi deploy thật
API_CORS_ORIGIN=http://localhost:5173

# URL dịch vụ định tuyến OSRM tự host mà service `api` gọi tới (nội bộ
# Docker network, không publish port ra ngoài) — xem map-tour/routing/build.ps1
OSRM_URL=http://osrm:5000

# Khóa bí mật bảo vệ trang admin nhập dữ liệu Excel (/api/admin/import/*).
# Không đặt = tắt hoàn toàn các route admin. Đổi giá trị này khi deploy thật,
# không dùng chung với bất kỳ mật khẩu nào khác.
ADMIN_IMPORT_KEY=
